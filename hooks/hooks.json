{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/curiosity-dispatch.mjs\" sessionStart",
        "timeout": 5,
        "failClosed": false
      }
    ],
    "subagentStart": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/curiosity-dispatch.mjs\" subagentStart",
        "timeout": 5,
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/curiosity-dispatch.mjs\" beforeShellExecution",
        "timeout": 5,
        "failClosed": true
      }
    ],
    "beforeReadFile": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/curiosity-dispatch.mjs\" beforeReadFile",
        "timeout": 5,
        "failClosed": true
      }
    ],
    "postToolUse": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/curiosity-dispatch.mjs\" postToolUse",
        "timeout": 5,
        "failClosed": false,
        "matcher": "Shell"
      }
    ],
    "preCompact": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/curiosity-dispatch.mjs\" preCompact",
        "timeout": 5,
        "failClosed": false
      }
    ]
  }
}
